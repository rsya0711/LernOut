generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  UTBK
}

enum QuestionType {
  MULTIPLE_CHOICE
  SHORT_ANSWER
  BOOLEAN
}

// ----------------------------------------------------
// USER & IDENTITY
// ----------------------------------------------------

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  username     String    @unique
  passwordHash String
  fullName     String?
  avatarUrl    String?
  role         Role      @default(USER)
  xp           Int       @default(0)
  level        Int       @default(1)
  streak       Int       @default(0)
  lastActiveAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  courseProgresses UserCourseProgress[]
  lessonProgresses UserLessonProgress[]
  quizAttempts     UserQuizAttempt[]
  examAttempts     ExamAttempt[]
  userAchievements UserAchievement[]
  streakLogs       StreakLog[]
  managedCategories Category[] @relation("AdminCategories")

  @@index([xp(sort: Desc)])
  @@index([streak(sort: Desc)])
  @@index([username])
}

// ----------------------------------------------------
// COURSES, MODULES & LESSONS (Flexible Hierarchy)
// ----------------------------------------------------

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  icon        String?
  description String?
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courses Course[]
  admins  User[]   @relation("AdminCategories")

  @@index([slug])
  @@index([orderIndex])
}

model Course {
  id          String      @id @default(uuid())
  categoryId  String
  title       String
  slug        String      @unique
  description String
  thumbnail   String?
  level       CourseLevel @default(BEGINNER)
  isPublished Boolean     @default(false)
  orderIndex  Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  category         Category             @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  modules          Module[]
  quizzes          Quiz[]
  courseProgresses UserCourseProgress[]

  @@index([categoryId])
  @@index([slug])
  @@index([isPublished])
}

model Module {
  id          String   @id @default(uuid())
  courseId    String
  title       String
  description String?
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]
  quizzes Quiz[]

  @@index([courseId])
  @@index([orderIndex])
}

model Lesson {
  id              String   @id @default(uuid())
  moduleId        String
  title           String
  slug            String?
  orderIndex      Int      @default(0)
  xpReward        Int      @default(15)
  content         String   @db.Text
  durationMinutes Int      @default(5)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  module           Module               @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lessonProgresses UserLessonProgress[]

  @@index([moduleId])
  @@index([orderIndex])
}

// ----------------------------------------------------
// QUIZ & QUESTION ENGINE
// ----------------------------------------------------

model Quiz {
  id           String   @id @default(uuid())
  moduleId     String?
  courseId     String?
  title        String
  description  String?
  passingScore Int      @default(70)
  xpReward     Int      @default(50)
  orderIndex   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  module       Module?           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  course       Course?           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions    Question[]
  quizAttempts UserQuizAttempt[]

  @@index([moduleId])
  @@index([courseId])
}

model Question {
  id           String       @id @default(uuid())
  quizId       String?
  examTryoutId String?
  prompt       String       @db.Text
  explanation  String?      @db.Text
  points       Int          @default(10)
  type         QuestionType @default(MULTIPLE_CHOICE)
  orderIndex   Int          @default(0)
  categoryTag  String? // e.g., 'TPS - Penalaran Umum', 'Literasi Bahasa'
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  quiz               Quiz?               @relation(fields: [quizId], references: [id], onDelete: Cascade)
  examTryout         ExamTryout?         @relation(fields: [examTryoutId], references: [id], onDelete: Cascade)
  options            Option[]
  quizAnswers        UserQuizAnswer[]
  examAttemptAnswers ExamAttemptAnswer[]

  @@index([quizId])
  @@index([examTryoutId])
  @@index([categoryTag])
}

model Option {
  id         String   @id @default(uuid())
  questionId String
  text       String   @db.Text
  isCorrect  Boolean  @default(false)
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  question           Question            @relation(fields: [questionId], references: [id], onDelete: Cascade)
  quizAnswers        UserQuizAnswer[]
  examAttemptAnswers ExamAttemptAnswer[]

  @@index([questionId])
}

// ----------------------------------------------------
// USER PROGRESS & QUIZ ATTEMPTS
// ----------------------------------------------------

model UserCourseProgress {
  id              String    @id @default(uuid())
  userId          String
  courseId        String
  progressPercent Float     @default(0)
  isCompleted     Boolean   @default(false)
  enrolledAt      DateTime  @default(now())
  completedAt     DateTime?
  updatedAt       DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model UserLessonProgress {
  id          String    @id @default(uuid())
  userId      String
  lessonId    String
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
}

model UserQuizAttempt {
  id             String   @id @default(uuid())
  userId         String
  quizId         String
  score          Float
  totalQuestions Int
  correctAnswers Int
  xpEarned       Int      @default(0)
  isPassed       Boolean  @default(false)
  completedAt    DateTime @default(now())

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz    Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers UserQuizAnswer[]

  @@index([userId])
  @@index([quizId])
}

model UserQuizAnswer {
  id               String  @id @default(uuid())
  attemptId        String
  questionId       String
  selectedOptionId String?
  isCorrect        Boolean @default(false)

  attempt        UserQuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption Option?         @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@index([attemptId])
  @@index([questionId])
}

// ----------------------------------------------------
// GAMIFICATION: ACHIEVEMENTS & STREAK LOGS
// ----------------------------------------------------

model Achievement {
  id          String   @id @default(uuid())
  code        String   @unique
  title       String
  description String
  iconUrl     String?
  xpBonus     Int      @default(50)
  category    String   @default("GENERAL") // STREAK, LESSON, QUIZ, EXAM
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userAchievements UserAchievement[]

  @@index([code])
}

model UserAchievement {
  id            String   @id @default(uuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
}

model StreakLog {
  id        String   @id @default(uuid())
  userId    String
  date      DateTime @db.Date
  xpEarned  Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

// ----------------------------------------------------
// UTBK / TRYOUT EXAM ENGINE
// ----------------------------------------------------

model ExamTryout {
  id              String   @id @default(uuid())
  title           String
  slug            String   @unique
  description     String   @db.Text
  durationMinutes Int      @default(90)
  totalQuestions  Int      @default(30)
  passingScore    Float    @default(600) // UTBK typical scale 200-800 or percentage
  isPublished     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  questions Question[]
  attempts  ExamAttempt[]

  @@index([slug])
  @@index([isPublished])
}

model ExamAttempt {
  id           String    @id @default(uuid())
  userId       String
  examTryoutId String
  startedAt    DateTime  @default(now())
  submittedAt  DateTime?
  score        Float?
  isFinished   Boolean   @default(false)

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  examTryout ExamTryout          @relation(fields: [examTryoutId], references: [id], onDelete: Cascade)
  answers    ExamAttemptAnswer[]

  @@index([userId])
  @@index([examTryoutId])
}

model ExamAttemptAnswer {
  id               String   @id @default(uuid())
  examAttemptId    String
  questionId       String
  selectedOptionId String?
  isDoubtful       Boolean  @default(false) // Fitur tombol 'Ragu-ragu' UTBK
  isCorrect        Boolean?
  updatedAt        DateTime @updatedAt

  examAttempt    ExamAttempt @relation(fields: [examAttemptId], references: [id], onDelete: Cascade)
  question       Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption Option?     @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@unique([examAttemptId, questionId])
  @@index([examAttemptId])
  @@index([questionId])
}
